{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sndmail",
  "version": "0.4.21",
  "identifier": "com.anydaysomething.sndmail",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run worker:prepare && npm run semantic:prepare && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "sndmail",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 400,
        "height": 300,
        "decorations": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost https: http://localhost:11434 http://localhost:1234 http://127.0.0.1:11434 http://127.0.0.1:1234; img-src 'self' data: blob: https: http:; font-src 'self' data:; frame-src 'self'"
    },
    "trayIcon": null
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.13",
      "signingIdentity": "-",
      "files": {
        "Helpers/SndmailWorker.app": "binaries/SndmailWorker.app"
      },
      "bundleVersion": "015"
    },
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "semantic-runtime/": "semantic-runtime/"
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:sndmail.db"
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCN0UzOUU1Mzg2NTc5N0UKUldSK2VXVTQ1VGwrVzVQcVQ4Sk5qVGNPeWE3Y2RJODJQZW9xZi9uRk1XWnMrWXl6Z2M5YzNxTVYK",
      "endpoints": []
    },
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": [
          "mailto",
          "sndmail"
        ]
      }
    }
  }
}
